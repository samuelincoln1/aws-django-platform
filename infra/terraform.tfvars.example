# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

project_name = "django-app"
environment  = "prod"
aws_region   = "us-east-1"

domain_name                = "app.example.com"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
alb_certificate_arn        = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
route53_zone_id            = null # e.g. "Z0123456789ABCDEFGHIJ" to create the DNS record

static_bucket_name = "example-django-app-static"

repository_provider = "GitHub"
repository_id       = "your-user/aws-django-platform"
branch_name         = "main"

# Secrets are ephemeral: prefer passing them as environment variables instead
# of writing them here, e.g.
#   export TF_VAR_django_secret_key="$(python -c 'import secrets; print(secrets.token_urlsafe(50))')"
#   export TF_VAR_db_password="$(openssl rand -base64 24 | tr -d '/@" ')"
